#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -35
        self.b = -64
        self.c = 54
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(72, -11, 18)
q = P(73, -10, 19)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

