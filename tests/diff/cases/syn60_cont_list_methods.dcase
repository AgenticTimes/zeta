#@@ python
xs = [3, 1, 2]
xs.append(4)
xs.extend([5, 6])
xs.insert(0, 0)
xs.remove(3)
print(xs.pop(), len(xs))
xs.sort()
print(xs)
xs.reverse()
print(xs)
