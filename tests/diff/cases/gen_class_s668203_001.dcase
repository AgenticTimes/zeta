#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -69
        self.b = 59
        self.c = 85
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(-84, -90, -59)
q = P(-83, -89, -58)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

