# @note: 随机类/字段/方法（seed=729202 #1）——W1010/W1011 修复普查面
#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -35
        self.b = -21
        self.c = -24
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(19, -86, -52)
q = P(20, -85, -51)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

