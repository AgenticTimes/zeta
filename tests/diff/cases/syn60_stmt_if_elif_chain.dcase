#@@ python
def go(v):
    if v < 0:
        return 'neg'
    elif v == 0:
        return 'zero'
    elif v < 10:
        return 'small'
    else:
        return 'big'
print(go(-3), go(0), go(5), go(50))
#@@ zeta
def go(v):
    if v < 0:
        return 'neg'
    elif v == 0:
        return 'zero'
    elif v < 10:
        return 'small'
    else:
        return 'big'
print(go(-3), go(0), go(5), go(50))
