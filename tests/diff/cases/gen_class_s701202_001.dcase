#@@ python
class P:
    def __init__(self, a, b):
        self.a = a
        self.b = b
    def total(self):
        return self.a + self.b
    def setall(self, o):
        self.a = -69
        self.b = -25
    def combined(self, o):
        return self.a + self.b + o.a + o.b

p = P(11, 80)
q = P(12, 81)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

