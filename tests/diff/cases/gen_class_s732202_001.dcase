# @note: 随机类/字段/方法（seed=732202 #1）——W1010/W1011 修复普查面
#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -92
        self.b = 62
        self.c = 29
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(-84, 89, -43)
q = P(-83, 90, -42)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

