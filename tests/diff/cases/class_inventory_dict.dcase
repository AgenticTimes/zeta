class Inventory:
    def __init__(self):
        self.stock = {}
    def add_item(self, name, qty):
        if name in self.stock:
            self.stock[name] += qty
        else:
            self.stock[name] = qty
    def total(self):
        return sum(self.stock.values())
    def report(self):
        for k in sorted(self.stock.keys()):
            print(k, self.stock[k])
        return self.total()

inv = Inventory()
inv.add_item("wheat", 100)
inv.add_item("corn", 50)
inv.add_item("wheat", 30)
print(inv.total())
print(inv.report())
print(inv.stock["wheat"])
