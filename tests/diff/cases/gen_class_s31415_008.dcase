# @cat: container
# @note: 随机类/字段/方法（seed=31415 #8）——W1010/W1011 修复普查面
#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = 14
        self.b = -74
        self.c = 90
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(-75, 31, -42)
q = P(-74, 32, -41)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

