class TextStats:
    def __init__(self, words):
        self.words = words
        self.counts = {}
    def build(self):
        for w in self.words:
            k = w[0]
            if k in self.counts:
                self.counts[k] += 1
            else:
                self.counts[k] = 1
        return len(self.counts)
    def top(self):
        best = ""
        n = 0
        for k in self.counts:
            if self.counts[k] > n:
                n = self.counts[k]
                best = k
        return best

t = TextStats(["apple", "avocado", "banana", "blueberry", "cherry"])
print(t.build())
print(t.top())
