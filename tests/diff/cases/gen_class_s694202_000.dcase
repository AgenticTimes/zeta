#@@ python
class P:
    def __init__(self, a, b):
        self.a = a
        self.b = b
    def total(self):
        return self.a + self.b
    def setall(self, o):
        self.a = -11
        self.b = 71
    def combined(self, o):
        return self.a + self.b + o.a + o.b

p = P(-98, 59)
q = P(-97, 60)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

