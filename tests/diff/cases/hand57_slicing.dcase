xs = [0, 1, 2, 3, 4, 5]
print(xs[1:4], xs[:3], xs[3:], xs[:], xs[::2], xs[::-1])
print(xs[-3:], xs[:-3], xs[-6:-4], xs[4:2], xs[2:8])
print(xs[10:], xs[:10], xs[-10:])
