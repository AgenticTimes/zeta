#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = 37
        self.b = -52
        self.c = 39
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(-98, 12, 53)
q = P(-97, 13, 54)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

