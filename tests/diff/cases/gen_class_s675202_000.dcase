#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = 73
        self.b = -53
        self.c = 17
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(28, 31, 64)
q = P(29, 32, 65)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

