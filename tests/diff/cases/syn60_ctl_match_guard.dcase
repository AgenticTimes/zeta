#@@ python
def go(n):
    match n:
        case x if x < 0:
            return 'neg'
        case x if x < 10:
            return 'small'
        case _:
            return 'big'
print(go(-1), go(5), go(50))
#@@ zeta
def go(n):
    match n:
        case x if x < 0:
            return 'neg'
        case x if x < 10:
            return 'small'
        case _:
            return 'big'
print(go(-1), go(5), go(50))
