# @cat: control
# @note: 随机控制流（seed=1122 #6）——else/break/continue 组合
#@@ python
s = 0
for i in range(4):
    s += i
    if i == 4:
        continue
    s += 1
    s += 2
else:
    s += 100
print(s)

