# @note: 随机类/字段/方法（seed=727202 #0）——W1010/W1011 修复普查面
#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = 8
        self.b = 85
        self.c = -3
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(-25, 29, -90)
q = P(-24, 30, -89)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

