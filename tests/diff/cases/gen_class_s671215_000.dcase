# @note: 随机类/字段/方法（seed=671215 #0）——W1010/W1011 修复普查面
#@@ python
class P:
    def __init__(self, a, b):
        self.a = a
        self.b = b
    def total(self):
        return self.a + self.b
    def setall(self, o):
        self.a = 91
        self.b = 28
    def combined(self, o):
        return self.a + self.b + o.a + o.b

p = P(-44, 64)
q = P(-43, 65)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

