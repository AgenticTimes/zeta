#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = 38
        self.b = -90
        self.c = 43
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(45, 6, 22)
q = P(46, 7, 23)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

