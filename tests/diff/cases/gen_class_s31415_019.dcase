class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = 10
        self.b = -10
        self.c = -77
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(-37, -92, -6)
