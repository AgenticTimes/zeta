# @cat: control
# @note: 随机控制流（seed=95013 #1）——else/break/continue 组合
#@@ python
s = 0
for i in range(7):
    s += i
    if i == 7:
        continue
    s += 1
    if i == 2:
        break
    s += 2
else:
    s += 100
print(s)

