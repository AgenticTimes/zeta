#@@ python
class P:
    def __init__(self, a, b):
        self.a = a
        self.b = b
    def total(self):
        return self.a + self.b
    def setall(self, o):
        self.a = -62
        self.b = -49
    def combined(self, o):
        return self.a + self.b + o.a + o.b

p = P(-65, -24)
q = P(-64, -23)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

