#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -79
        self.b = 10
        self.c = -30
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(-61, 2, 95)
q = P(-60, 3, 96)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

