#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = 37
        self.b = 4
        self.c = 26
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(-67, -71, 51)
q = P(-66, -70, 52)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

