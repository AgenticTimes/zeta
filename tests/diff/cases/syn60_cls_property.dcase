# @note: 批次 10060 语法形态探针（CPython 与 zetac 逐行一致，两份同文）
#@@ python
class P:
    def __init__(self):
        self._v = 1
    @property
    def v(self):
        return self._v * 10
print(P().v)
#@@ zeta
class P:
    def __init__(self):
        self._v = 1
    @property
    def v(self):
        return self._v * 10
print(P().v)
