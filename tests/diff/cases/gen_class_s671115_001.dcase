# @note: 随机类/字段/方法（seed=671115 #1）——W1010/W1011 修复普查面
#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -30
        self.b = -67
        self.c = 79
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(53, -20, -85)
q = P(54, -19, -84)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

