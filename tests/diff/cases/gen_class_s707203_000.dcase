#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -65
        self.b = 30
        self.c = 79
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(58, 9, 92)
q = P(59, 10, 93)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

