# @cat: container
# @note: 列表切片赋值 v[1:3] = [...] 崩溃——lowering 走 __delitem__ 但列表
#        无此 C 函数。单索引赋值 v[0] = 99 正常（对照组）。
#        gen.rs/runtime 车道：需要列表切片赋值的 C shim 或降为逐元素赋值。
#@@ python
v = [1, 2, 3, 4, 5]
v[1:3] = [10, 20]
print(v)
v[0] = 99
print(v)
#@@ zeta
v = [1, 2, 3, 4, 5]
v[1:3] = [10, 20]
print(v)
v[0] = 99
print(v)
