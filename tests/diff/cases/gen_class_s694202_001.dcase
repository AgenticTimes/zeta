# @note: 随机类/字段/方法（seed=694202 #1）——W1010/W1011 修复普查面
#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -51
        self.b = 84
        self.c = 86
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(-23, -55, 96)
q = P(-22, -54, 97)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

