# @note: 随机类/字段/方法（seed=703202 #1）——W1010/W1011 修复普查面
#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = 32
        self.b = 60
        self.c = -62
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(47, 43, 80)
q = P(48, 44, 81)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

