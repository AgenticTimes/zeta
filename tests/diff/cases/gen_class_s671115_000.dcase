#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -89
        self.b = 78
        self.c = -93
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(-94, -56, 40)
q = P(-93, -55, 41)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

