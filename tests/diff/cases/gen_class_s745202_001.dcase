#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -58
        self.b = -18
        self.c = -77
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(68, -47, 46)
q = P(69, -46, 47)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

