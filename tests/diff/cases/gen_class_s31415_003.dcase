# @note: 随机类/字段/方法（seed=31415 #3）——W1010/W1011 修复普查面
#@@ python
class P:
    def __init__(self, a, b):
        self.a = a
        self.b = b
    def total(self):
        return self.a + self.b
    def setall(self, o):
        self.a = 34
        self.b = 79
    def combined(self, o):
        return self.a + self.b + o.a + o.b

p = P(-29, 36)
q = P(-28, 37)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

