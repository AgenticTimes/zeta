# @cat: control
# @note: if/elif/else 分支选择
#@@ python
def grade(s):
    if s >= 90:
        return 4
    elif s >= 60:
        return 2
    else:
        return 1
print(grade(95))
print(grade(70))
print(grade(30))
#@@ zeta
def grade(s: i64) -> i64:
    if s >= 90:
        return 4
    elif s >= 60:
        return 2
    else:
        return 1
print(grade(95))
print(grade(70))
print(grade(30))
