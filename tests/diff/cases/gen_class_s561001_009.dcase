# @note: 随机类/字段/方法（seed=561001 #9）——W1010/W1011 修复普查面
#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -22
        self.b = -20
        self.c = -1
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(50, 8, 7)
q = P(51, 9, 8)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

