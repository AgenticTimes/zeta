# @note: 随机类/字段/方法（seed=31415 #18）——W1010/W1011 修复普查面
#@@ python
class P:
    def __init__(self, a, b):
        self.a = a
        self.b = b
    def total(self):
        return self.a + self.b
    def setall(self, o):
        self.a = 23
        self.b = 88
    def combined(self, o):
        return self.a + self.b + o.a + o.b

p = P(-39, 9)
q = P(-38, 10)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

