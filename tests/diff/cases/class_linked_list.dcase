# @cat: container
# @note: 链表正向验证——self.next 赋值/链式访问/is not None/字段读取全通
#        （OOP 能力确认：自引用类、对象赋值到字段、链式取值）
#@@ python
class Node:
    def __init__(self, val):
        self.val = val
        self.next = None
    def has_next(self):
        return self.next is not None

a = Node(1)
b = Node(2)
a.next = b
print(a.has_next())
print(b.has_next())
print(a.val)
print(b.val)
print(a.next.val)
#@@ zeta
class Node:
    def __init__(self, val):
        self.val = val
        self.next = None
    def has_next(self):
        return self.next is not None

a = Node(1)
b = Node(2)
a.next = b
print(a.has_next())
print(b.has_next())
print(a.val)
print(b.val)
print(a.next.val)
