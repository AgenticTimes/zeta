#@@ python
class P:
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c
    def total(self):
        return self.a + self.b + self.c
    def setall(self, o):
        self.a = -51
        self.b = -69
        self.c = 82
    def combined(self, o):
        return self.a + self.b + self.c + o.a + o.b + o.c

p = P(60, -25, -1)
q = P(61, -24, 0)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

