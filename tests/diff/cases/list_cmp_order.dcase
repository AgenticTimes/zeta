# @cat: container
# @note: 列表字典序比较——< 与 <= 错（句柄比较？），> 与 == 对（批次 499 定性）
#@@ python
print([1, 2] < [1, 3])
print([1, 2] <= [1, 3])
print([3] > [1, 9])
print([1, 2, 3] > [1, 2])
print([1, 2] == [1, 2])
#@@ zeta
print([1, 2] < [1, 3])
print([1, 2] <= [1, 3])
print([3] > [1, 9])
print([1, 2, 3] > [1, 2])
print([1, 2] == [1, 2])
