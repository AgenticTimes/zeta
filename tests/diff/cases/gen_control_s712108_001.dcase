# @cat: control
# @note: 随机控制流（seed=712108 #1）——else/break/continue 组合
#@@ python
s = 0
i = 0
while i < 5:
    s += i
    if i == 2:
        continue
    s += 1
    if i == 0:
        break
    s += 2
else:
    s += 100
print(s)

