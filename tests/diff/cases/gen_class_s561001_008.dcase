#@@ python
class P:
    def __init__(self, a, b):
        self.a = a
        self.b = b
    def total(self):
        return self.a + self.b
    def setall(self, o):
        self.a = -21
        self.b = -94
    def combined(self, o):
        return self.a + self.b + o.a + o.b

p = P(7, -15)
q = P(8, -14)
print(p.total())
print(q.total())
p.setall(q)
print(p.total())
print(p.combined(q))

