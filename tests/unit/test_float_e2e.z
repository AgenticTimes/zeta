fn test_float_add() -> f64 {
    let a = 1.5;
    let b = 2.5;
    return a + b;
}

fn test_float_mul() -> f64 {
    let x = 3.0;
    let y = 4.0;
    return x * y;
}

fn main() -> i64 {
    let sum = test_float_add();
    let prod = test_float_mul();
    if sum == 4.0 && prod == 12.0 {
        return 0;
    }
    return 1;
}
