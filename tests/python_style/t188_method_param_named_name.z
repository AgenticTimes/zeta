// PY-A: **方法参数名叫 `name`** 时，调用点曾经解析到一个「无关的桩」——
//   `get_or_declare_function` 的 `::` 分支在精确名查不到时会回退到**变形名/平名** ✗，
//   而平名 `column` 恰好存在（一个返回 i64 的重复体）⇒ 静默错值 / 段错误 ✗。
//   修法：精确限定名查不到时，**直接按限定名声明**（定义可能在本模块稍后生成 ✓），
//   不再回退到变形名或平名 ✓。
//   注：方法**返回值**的类型仍需注解（`lt(vec, str)`）才能正确取元素 —— 那是另一处，本用例不断言。
// expect: 2
// expect: 1   (只有一列)
class F:
    def __init__(self, d: lt(map, str)):
        self.d = d

    def column(self, name):
        return self.d[name]

    def n_columns(self):
        return len(self.d)


f = F({"code": ["x", "y"]})
print(len(f.column("code")))
print(f.n_columns())
