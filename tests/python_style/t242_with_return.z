// PY-A: `with lock: return` must compile (no LLVM terminator-after-return).
// expect: 1
_lock = 0

def early():
    with _lock:
        return 7

def main() -> i64:
    # Call for side-effect of compiling the with+return shape; value may be
    # wrong if lock handle has no real __enter__ — link/run must succeed.
    _ = early()
    print(1)
    return 0
