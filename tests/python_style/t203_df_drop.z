// PY-A: DataFrame.drop 删列（copy+del）+ df.index=range(n_rows)。
// 位置 `drop(["x"])`；`columns=["x"]` 按**名字**绑到 pandas.z 的 `columns` 形参。
// （批次 412 前它靠"kwargs 名不匹配 ⇒ 实参左移进 labels"的巧合通过，左移已修。）
// df.values 嵌套矩阵本批不做。
// expect: 1
// expect: False
// expect: True
// expect: a
// expect: 2
// expect: 1
// expect: False
// expect: 2
// expect: 0
// expect: 1
from pandas import DataFrame

a = DataFrame({"code": ["a", "b"], "x": ["1", "2"]})
b = a.drop(["x"])
print(len(b.columns))
print("x" in b)
print("code" in b)
print(b["code"][0])
# 原表未变
print(len(a.columns))
# 语料/探针拼写 columns=（单参方法把 kwargs 值绑到 labels）
c = a.drop(columns=["x"])
print(len(c.columns))
print("x" in c)
idx = a.index
print(len(idx))
print(idx[0])
print(idx[1])
