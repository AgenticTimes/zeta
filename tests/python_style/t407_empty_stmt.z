// 批次 339：裸 `;` 是**顶层空项**，不是"停下"的信号（MIR 层由
// tools/empty_stmt_inventory.sh 锁，这里锁语义层：跑起来到底打印什么）。
// 修复前这个文件**一条都不打**——首行的 `;` 让顶层 many0 当场停止，后面的
// fn first / def second / fn main 全被丢掉（W1002 响了，但程序已经没了，
// 而且退出码 0）。
// 注意：`holder::inner()` 不在这里调用——mod 作用域下的函数调用打的是地址，
// 那是另一条既有缺陷（两版二进制 MIR 逐字节相同可反证与本批无关），见 roadmap 批次 339 OPEN。
// expect: 1
// expect: 2
// expect: 4
;

fn first() -> i64 {
    return 1
}
;;

mod holder {
    ;
    fn inner() -> i64 {
        return 3
    }
}

def second():
    return 2
;

fn main() {
    ;
    print(first())
    print(second())
    print(4)
}
