// PY-A: `obj[k]=v` → `__setitem__`；此前 Named 走 DictInsert 段错误。
//   map 赋值键也改用 lower_map_key_typed，方法内 `self.d[key]=v` 才能命中内容哈希。
// expect: 1
// expect: y
// expect: z
class F:
    def __init__(self, d: lt(map, str)):
        self.d = d
    def __setitem__(self, key, val):
        self.d[key] = val
    def __getitem__(self, key):
        return self.d[key]

f = F({})
f["a"] = 1
print(f["a"])

from pandas import DataFrame
a = DataFrame({"code": ["x"]})
a["code"] = ["y"]
print(a["code"][0])
a["new"] = ["z"]
print(a["new"][0])
