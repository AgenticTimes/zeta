// PY-A: pylib/numpy.z wrappers (arange/asarray/zeros) + mean/any.
// Registry F 已撤下这几项；库实现经 py_member_call，vec 返回类型靠注解。
// expect: 3
// expect: 1
// expect: 2
// expect: 9
// expect: 0
// expect: 0
// expect: 2
// expect: True
import numpy as np

def main() -> i64:
    a = np.arange(3)
    print(len(a))
    print(a[1])
    b = np.asarray([9, 8])
    print(len(b))
    print(b[0])
    z = np.zeros(2)
    print(z[0])
    print(z[1])
    print(np.mean([1, 2, 3]))
    print(np.any([0, 1, 0]))
    return 0
