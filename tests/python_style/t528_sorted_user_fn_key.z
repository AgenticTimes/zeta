// 批次 561（旁路 cleanup）：sorted(key=用户函数) 的 FuncAddr 路径实证钉。
// 用户函数经 FuncAddr 传 py_sorted_key，运行期按 zeta 调用约定回调；
// 整型键升序与 reverse 降序均与 CPython 3.14 逐字对齐（561 实测）。
// （内建键 abs/None 已由批次 560 收口，见 t527。）
def neg(x: i64) -> i64:
    return -x

v = [1, -3, 2]
print(sorted(v, key=neg))
print(sorted(v, key=neg, reverse=True))
print(sorted(v, key=abs, reverse=True))
// expect: [2, 1, -3]
// expect: [-3, 1, 2]
// expect: [-3, 2, 1]
