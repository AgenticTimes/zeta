// 批次 465（旁路 cleanup）：`fn f();` 原型声明 —— backlog #61 / #67 的 `fn…;` 成员。
//
// 修前：`fn f(...)` 后跟 `;` 走进函数体解析臂，既不是 `{` 也不是 `:` ⇒ 解析失败
// ⇒ many0 停摆，整个文件从 `fn` 那行起被丢（W1002，顶层与 def 体内同样截断）。
// 修后：无 `extern` 前缀、以 `;` 收尾的原型与 `extern fn f(...);` 同路——
// 签名承诺、external linkage、缺实现 = 链接期响亮失败。
//
// 语义实测（本用例前两段）：同文件"原型在前、实现在后"时调用解析到实现（打印 7）；
// 从未被调用的原型只产生外部声明、无引用即无链接需求（g 就是这样，链接通过）。
fn f();
fn f() -> i64 {
    return 7
}
fn unused_proto(x: i64) -> i64;
fn main() -> i64 {
    let r = f()
    print(r)
    0
}
// expect: 7
