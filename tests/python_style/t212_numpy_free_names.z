import numpy as np
from numpy import arange, asarray, linspace, sum as npsum

print(arange(3)[1])
print(linspace(0, 10, 3)[1])
print(npsum([1, 2, 3]))
print(asarray([9, 8])[0])
print(np.arange(4)[2])
print(np.linspace(0, 10, 3)[1])
print(np.sum([1, 2, 3]))
print(np.asarray([9, 8])[0])
