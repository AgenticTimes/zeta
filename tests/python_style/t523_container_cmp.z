// 批次 553（旁路 cleanup）：容器比较族——list/tuple 的 < <= > >= == !=
// 走词典序（py_list_cmp 先出 -1/0/1 再与 0 比较），dict 的 == != 走
// map__eq 键值全等。此前整型回退比的是句柄，[1,2] < [1,3] 恒 False。
// 值比较按 word：内容等但不同对象的字符串值在 dict == 里不算等
// （#117 值标记家族的登记角）。
print([1, 2] < [1, 3])
print((1, 2) < (1, 3))
print((1, 2) == (1, 3))
print([1, 2] <= [1, 2])
print([2] >= [1, 9])
print([3, 1] < [3, 1, 0])
print(["a", "b"] < ["b"])
print(["a"] < ["a", "b"])
t1 = (1, 2)
t2 = (1, 3)
print(t1 < t2)
print(t1 != t2)
print(t1 == (1, 2))
d1 = {"a": 1}
d2 = {"a": 1}
print(d1 == d2)
print(d1 != d2)
print([1, 2] == [1, 2])
print([1, 2] != [1, 3])
// expect: True
// expect: True
// expect: False
// expect: True
// expect: True
// expect: True
// expect: True
// expect: True
// expect: True
// expect: True
// expect: True
// expect: True
// expect: False
// expect: True
// expect: True
