// PY-A: DataFrame.reset_index / fillna / astype 库侧 typed copy。
// 此前：reset_index 链接缺 `_DataFrame__reset_index`；fillna/astype 走 opaque
// zeta_identity → 结果标 i64，len(columns) 静默 0。groupby 从 identity 移除后
// 链接失败（响亮），本用例不覆盖。
// expect: 2
// expect: True
// expect: True
// expect: 2
// expect: a
// expect: 1
// expect: 2
// expect: True
// expect: True
// expect: 2
// expect: a
from pandas import DataFrame

a = DataFrame({"code": ["a", "b"], "x": ["1", "2"]})
b = a.reset_index(drop=True)
print(len(b.columns))
print("code" in b)
print("x" in b)
c = a.fillna(0)
print(len(c.columns))
print(c["code"][0])
print(c["x"][0])
d = a.astype("str")
print(len(d.columns))
print("code" in d)
print("x" in d)
# 无参 reset_index 也通（默认 drop）
e = a.reset_index()
print(len(e.columns))
print(e["code"][0])
