// PY-A: np.eye / np.zeros((r,c)) / np.diag — flat row-major V1.
// expect: 1
// expect: 0
// expect: 0
// expect: 5
import numpy as np

def main() -> i64:
    e = np.eye(2)
    print(e[0])
    print(e[1])
    z = np.zeros((2, 2))
    print(z[0])
    d = np.diag([5, 7])
    print(d[0])
    return 0
