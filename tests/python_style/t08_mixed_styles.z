// PY-2: 双向混合风格 —— 花括号 fn 内用缩进、缩进 fn 内用花括号
// expect: 33
fn brace_fn() -> i64 {
    if true {
        return 11
    }
    return 0
}

fn indent_fn() -> i64:
    if true {
        return 22
    }
    return 0

fn main() -> i64:
    let a = brace_fn()
    let b = indent_fn()
    println_i64(a + b)
    return 0
