// PY-A: random（xorshift64*，非 libc rand）+ itertools 子集（eager，基于 Vec）
// expect: 1
// expect: 1
// expect: 1
// expect: 1
// expect: 4
// expect: 5
// expect: 2
// expect: 2
import random
import itertools

random.seed(42)
n = random.randint(1, 10)
if n >= 1 and n <= 10:
    print(1)
if int(random.uniform(1.0, 2.0)) == 1 or int(random.uniform(1.0, 2.0)) == 2:
    print(1)
xs = [1, 2, 3]
v = random.choice(xs)
if v >= 1 and v <= 3:
    print(1)
random.shuffle(xs)
if len(xs) == 3:
    print(1)
print(len(itertools.chain([1, 2], [3, 4])))
print(len(itertools.repeat(7, 5)))
print(len(itertools.islice([1, 2, 3, 4, 5], 1, 3)))
print(itertools.count([1, 2, 1], 1))
