// PY-A: 科学计数法字面量 —— `1e8` 曾完全不支持，且**静默错值**：
//   `v = 1e8` 被解析成 `v = 1` + 一个游离的标识符语句（`e8`），打印 1；
//   而 `f(1e8)` / `(1e8)` / `[1e8]` 里那个游离的 `e8` 让括号不闭合，
//   整个顶层项被丢弃（语料三个 get_stock_list 文件都命中 `> 1e8`）。
// expect: 100000000.000000
// expect: 0.001500
// expect: 20000000000.000000
// expect: [100, 1000]
// expect: 1
// expect: 0
// expect: -100000000.000000
// expect: 1000.000000
def big(x: f64) -> i64:
    if x > 1e6:
        return 1
    return 0

v = 1e8
print(v)
print(1.5e-3)
print(2E+10)
xs = [1e2, 1e3]
print(xs)
print(big(1e8))
print(big(1.0))
print(-1e8)
n = 1_0e2
print(n)
