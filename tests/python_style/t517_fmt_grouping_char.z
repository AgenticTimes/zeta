// 批次 544（旁路 cleanup）：f-string ',' 分组与 'c' 类型符的角点钉。
// 分组：正值/负值/零/小数字/无类型默认 d；CPython 补零规则是"先按
// 位数十进制补零、再插逗号"（012,d → 0,001,234,567，总宽可超 width）；
// 非零宽度非补零时正常空格填充（11,d → 两个前导空格）。
// 'c'：chr(v) 单字符，默认左对齐（字符串规则，不是数值右对齐），
// 宽度/填充符照常生效。
i = 1234567
n = -1234567
z = 0
c = 65
f1 = 1234567.891
print(f"{i:,d}")
print(f"{n:,d}")
print(f"{z:,d}")
print(f"{1234:,d}")
print(f"{i:012,d}")
print(f"{i:11,d}")
print(f"{i:,}")
print(f"{c:c}")
print(f"{c:>5c}")
print(f"{c:*<5c}")
print(f"{f1:,.2f}")
print(f"{i:+,d}")
// expect: 1,234,567
// expect: -1,234,567
// expect: 0
// expect: 1,234
// expect: 0,001,234,567
// expect:   1,234,567
// expect: 1,234,567
// expect: A
// expect:     A
// expect: A****
// expect: 1,234,567.89
// expect: +1,234,567
