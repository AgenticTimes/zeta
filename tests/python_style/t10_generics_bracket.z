// PY-3: fn f[T](...) 方括号泛型声明 + T 参数实例化 E2E（2026-09-11 修复：
// is_generic_function 误判 + 泛型函数从未按调用实例化）
// 已知缺口（roadmap）: 同一泛型函数的多类型实例化（需调用点类型推断）
// expect: 7
fn pick[T](a: T, b: T) -> T:
    if a > b:
        return a
    return b

fn main() -> i64:
    let a = pick(3, 7)
    println_i64(a)
    return 0
