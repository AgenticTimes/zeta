// PY-A: map(f, xs) / filter(f, xs)（eager，返回列表）—— 此前是裸 extern 链接失败
//   filter(None, xs) 按真值过滤
// expect: [2, 4, 6, 8]
// expect: [1, 3]
// expect: [1, 2, 3]
def twice(v) -> i64:
    return v * 2

def is_odd(v) -> i64:
    return v % 2

xs = [1, 2, 3, 4]
print(map(twice, xs))
print(filter(is_odd, xs))
print(filter(None, [0, 1, 2, 0, 3]))
