// PY-A: 列表方法 index/count/insert/remove/pop/sort/reverse
//   （此前 index/count 被 opaque-fallback 路由到字符串表 host_str_find/count，
//    其余是裸 extern → 链接失败）
// expect: 2
// expect: 1
// expect: [9, 3, 1, 2]
// expect: 2
// expect: [9, 3, 1]
// expect: 9
// expect: [3, 1]
// expect: [1, 3]
// expect: [3, 1]
// expect: [1]
xs = [3, 1, 2]
print(xs.index(2))
print(xs.count(2))
xs.insert(0, 9)
print(xs)
print(xs.pop())
print(xs)
print(xs.pop(0))
print(xs)
xs.sort()
print(xs)
xs.reverse()
print(xs)
xs.remove(3)
print(xs)
