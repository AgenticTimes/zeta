# pylib/pandas.z — 最小 pandas 库实现（列映射模型：一列 = 一个列表）。
#
# 这是**库实现**，不是编译器特例：`import pandas as pd` 会加载本文件，
# `pd.DataFrame(...)` 解析到这里的 `DataFrame`（模块限定名 `pandas__DataFrame`）。
# 支持：构造、concat（按列拼接）、列名列表、列数、列向量。
# 不支持（有意为之，保持响亮失败而不是假语义）：`df["col"]` 需要类的
# `__getitem__`，方言还没有；`sort_values`/`iloc` 是行级操作，列映射模型表达不了。


class DataFrame:
    def __init__(self, data: map):
        self.data = data

    def column(self, name: str):
        return self.data[name]

    def column_names(self):
        return list(self.data.keys())

    def n_columns(self):
        return len(self.data)

    def n_rows(self):
        names = list(self.data.keys())
        if len(names) == 0:
            return 0
        return len(self.data[names[0]])


def concat(frames, ignore_index=False):
    out = {}
    i = 0
    while i < len(frames):
        f = frames[i]
        names = list(f.data.keys())
        j = 0
        while j < len(names):
            name = names[j]
            col = f.data[name]
            if name in out:
                out[name] = out[name] + col
            else:
                out[name] = col
            j = j + 1
        i = i + 1
    return DataFrame(out)
