    return py_stub_abort("pandas.date_range")

# stub: pandas.to_datetime
def to_datetime(arg):
    return py_stub_abort("pandas.to_datetime")

# stub: pandas.to_numeric
def to_numeric(arg):
    return py_stub_abort("pandas.to_numeric")

# stub: soft:pandas.isna
def isna(x) -> bool:
    # 列映射无 NaN 哨兵 → 恒 False。`pd.isna` / 链式 `.isna`（opaque）另有路径。
    return False

# stub: soft:pandas.isnull
def isnull(x) -> bool:
    return False


# frames 必须标注 [DataFrame]：未标注时 frames[i] 丢掉 struct 字段（.data 变空/空指针）。
# lt(vec, DataFrame) 不够 —— 实测只有 `[DataFrame]` 能让元素类型落到下标结果上。
# map 的值类型由 `lt(map, str, vecstr)` / 字面量推断带上，列上的 `prev + col` 才能走列表拼接。
def concat(frames: [DataFrame], ignore_index=False):
    first = frames[0]
    colnames = first.column_names()
    ncols = len(colnames)
    out = {}
    j = 0
    while j < ncols:
        col_key = colnames[j]
        merged = first.column(col_key)
        i = 1
        nframes = len(frames)
        while i < nframes:
            f = frames[i]
            merged = merged + f.column(col_key)
            i = i + 1
        out[col_key] = merged
        j = j + 1
    return DataFrame(out)
